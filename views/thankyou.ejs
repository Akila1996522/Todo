<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thank You</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-purple-400 via-pink-500 to-red-500 text-white flex items-center justify-center h-screen">

  <div class="bg-white text-gray-800 rounded-xl p-10 shadow-lg text-center w-full max-w-md animate-fade-in-down">
    <h1 class="text-3xl font-bold mb-6">🎉 Thank You, <%= name %>!</h1>
    <p class="mb-4">We've received your message:</p>
    <div class="bg-gray-100 p-4 rounded text-left">
      <p><strong>Email:</strong> <%= email %></p>
      <p><strong>Message:</strong> <%= message %></p>
    </div>
    <a href="/" class="mt-6 inline-block bg-pink-600 hover:bg-pink-700 text-white py-2 px-4 rounded-full transition-all duration-300">
      Back to Home
    </a>
    <a href="/todo" class="mt-6 inline-block bg-yellow-600 hover:bg-yellow-700 text-white py-2 px-4 rounded-full transition-all duration-300">Go to ToDo List →</a>
  </div>

  <style>
    @keyframes fade-in-down {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-down {
      animation: fade-in-down 0.6s ease-out;
    }
  </style>
</body>
</html>
