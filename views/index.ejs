<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Contact Us</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          animation: {
            bounceIn: "bounceIn 1s ease-out forwards",
            pulseOnce: "pulse 1s ease-in-out 1"
          },
          keyframes: {
            bounceIn: {
              "0%": { opacity: 0, transform: "translateY(-50px) scale(0.9)" },
              "100%": { opacity: 1, transform: "translateY(0) scale(1)" }
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 min-h-screen flex items-center justify-center p-6">

  <div class="bg-white/30 backdrop-blur-lg rounded-3xl shadow-2xl p-8 w-full max-w-lg animate-bounceIn border border-white/50">
    <h1 class="text-4xl font-bold text-white text-center mb-8 flex items-center justify-center gap-2">
      <span>💖</span> Contact Us
    </h1>
    <form action="/contact" method="POST" class="flex flex-col gap-5">
      <div class="relative">
        <input type="text" name="name" placeholder="Your Name"
          class="w-full p-4 pl-12 rounded-full bg-white/70 border border-pink-400 focus:outline-none focus:ring-4 focus:ring-pink-300 shadow-md transition-all duration-300"
          required />
        <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-pink-500">👤</span>
      </div>

      <div class="relative">
        <input type="email" name="email" placeholder="Your Email"
          class="w-full p-4 pl-12 rounded-full bg-white/70 border border-purple-400 focus:outline-none focus:ring-4 focus:ring-purple-300 shadow-md transition-all duration-300"
          required />
        <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-purple-500">📧</span>
      </div>

      <div class="relative">
        <textarea name="message" placeholder="Your Message"
          class="w-full p-4 pl-12 rounded-2xl bg-white/70 border border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-300 shadow-md transition-all duration-300 resize-none h-32"
          required></textarea>
        <span class="absolute left-4 top-4 text-indigo-500">💬</span>
      </div>

      <button type="submit"
        class="mt-4 bg-gradient-to-r from-pink-500 to-purple-500 text-white font-semibold py-3 rounded-full shadow-lg hover:scale-105 hover:shadow-pink-300 transition-all duration-300 animate-pulseOnce">
        🚀 Send Message
      </button>
    </form>
  </div>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 1s ease-out;
    }
  </style>
</body>
</html>
